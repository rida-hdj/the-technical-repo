---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MainPostCard from '../../components/MainPostCard.astro';
import SmallPostCard from '../../components/SmallPostCard.astro';
import { getAllPosts, resolveSmallPosts } from '../../utils/articles';

const posts = await getAllPosts();

const sortByDateDesc = (a: typeof posts[0], b: typeof posts[0]) =>
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();

const mainPosts = posts
  .filter((p) => p.data.type === 'main')
  .sort(sortByDateDesc);

const smallPosts = posts
  .filter((p) => p.data.type === 'small')
  .sort(sortByDateDesc);

const smallWithParent = await resolveSmallPosts(smallPosts);
---

<BaseLayout
  title="المدونة"
  description="جميع مقالات المستودع التقني."
  currentPath={Astro.url.pathname}
>
  <section class="container section page-top">
    <div class="list-head">
      <h1>المدونة</h1>
    </div>

    <div class="blog-layout">
      <section>
        <div class="section-header">
          <h2 class="section-title-muted">مقالات رئيسية</h2>
        </div>
        {mainPosts.length > 0 ? (
          <div class="main-post-grid">
            {mainPosts.map((entry) => (
              <MainPostCard entry={entry} />
            ))}
          </div>
        ) : (
          <p>لا توجد مقالات رئيسية بعد.</p>
        )}
      </section>

      <section>
        <div class="section-header">
          <h2 class="section-title-muted">مقالات قصيرة</h2>
        </div>
        {smallWithParent.length > 0 ? (
          <div class="post-grid">
            {smallWithParent.map(({ entry, parent }) => (
              <SmallPostCard entry={entry} parent={parent} showImage />
            ))}
          </div>
        ) : (
          <p>لا توجد مقالات قصيرة بعد.</p>
        )}
      </section>
    </div>
  </section>
</BaseLayout>
