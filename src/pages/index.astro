---
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MainPostCard from '../components/MainPostCard.astro';
import SmallPostCard from '../components/SmallPostCard.astro';

const pathname = Astro.url.pathname;

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const mainPosts = posts.filter((p) => p.data.type === 'main');
const smallPosts = posts.filter((p) => p.data.type === 'small');

async function resolveSmallWithParent(): Promise<
  { entry: CollectionEntry<'posts'>; parent?: CollectionEntry<'posts'> }[]
> {
  const resolved = [];
  for (const entry of smallPosts) {
    const parent = entry.data.parent
      ? await getEntry('posts', entry.data.parent)
      : undefined;
    if (parent && !parent.data.draft) {
      resolved.push({ entry, parent });
    }
  }
  return resolved;
}

const smallWithParent = await resolveSmallWithParent();
const totalPosts = posts.length;
---

<BaseLayout
  title=""
  description="مدونة تقنية تهتم بشرح المفاهيم التقنية بشكل مبسط و باللغة العربية."
  currentPath={pathname}
>
  <section class="container hero">
    <h1>المستودع التقني</h1>
    <p>
      مدونة تقنية تهتم بشرح المفاهيم التقنية بشكل مبسط و باللغة العربية
    </p>
  </section>

  {mainPosts.length > 0 && (
    <section class="container section">
      <div class="section-header">
        <h2 class="section-title">مقالات رئيسية</h2>
      </div>
      <div class="main-post-grid">
        {mainPosts.map((entry, i) => (
          <MainPostCard entry={entry} eager={i < 2} />
        ))}
      </div>
    </section>
  )}

  {smallWithParent.length > 0 && (
    <section class="container section">
      <div class="section-header">
        <h2 class="section-title">مقالات قصيرة</h2>
      </div>
      <div class="post-grid">
        {smallWithParent.map(({ entry, parent }) => (
          <SmallPostCard entry={entry} parent={parent} />
        ))}
      </div>
    </section>
  )}

  {totalPosts === 0 && (
    <section class="container section">
      <p>لا توجد مقالات بعد.</p>
    </section>
  )}
</BaseLayout>