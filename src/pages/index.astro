---
import BaseLayout from '../layouts/BaseLayout.astro';
import MainPostCard from '../components/MainPostCard.astro';
import SmallPostCard from '../components/SmallPostCard.astro';
import { getAllPosts, resolveSmallPosts } from '../utils/articles';

const MAX_HOME_ARTICLES = 6;

const posts = await getAllPosts();

const mainPosts = posts
  .filter((p) => p.data.type === 'main')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, MAX_HOME_ARTICLES);

const smallPosts = posts
  .filter((p) => p.data.type === 'small')
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, MAX_HOME_ARTICLES);

const smallWithParent = await resolveSmallPosts(smallPosts);
---

<BaseLayout
  title=""
  description="مدونة تقنية تهتم بشرح المفاهيم التقنية بشكل مبسط و باللغة العربية."
  currentPath={Astro.url.pathname}
>
  <section class="container hero">
    <h1>المستودع التقني</h1>
    <p>
      مدونة تقنية تهتم بشرح المفاهيم التقنية بشكل مبسط و باللغة العربية
    </p>
  </section>

  {mainPosts.length > 0 && (
    <section class="container section">
      <div class="section-header">
        <h2 class="section-title">مقالات رئيسية</h2>
      </div>
      <div class="main-post-grid">
        {mainPosts.map((entry, i) => (
          <MainPostCard entry={entry} eager={i < 2} />
        ))}
      </div>
    </section>
  )}

  {smallWithParent.length > 0 && (
    <section class="container section">
      <div class="section-header">
        <h2 class="section-title">مقالات قصيرة</h2>
      </div>
      <div class="post-grid">
        {smallWithParent.map(({ entry, parent }) => (
          <SmallPostCard entry={entry} parent={parent} />
        ))}
      </div>
    </section>
  )}

  {posts.length === 0 && (
    <section class="container section">
      <p>لا توجد مقالات بعد.</p>
    </section>
  )}
</BaseLayout>
